# Copy this file to .env and fill in real values. Never commit .env itself.

# Neon Postgres connection string (Prisma)
DATABASE_URL=

# OpenAI — get from platform.openai.com (secret, fill in yourself)
OPENAI_API_KEY=

# Clerk auth — get these from your Clerk app's API Keys page (secrets, fill in yourself)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing — not secrets, safe to use these exact values
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk Playwright e2e testing (fill in yourself)
# CLERK_PUBLISHABLE_KEY: same value as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY above
# E2E_CLERK_USER_EMAIL: email of an existing, non-admin test account
CLERK_PUBLISHABLE_KEY=
E2E_CLERK_USER_EMAIL=
